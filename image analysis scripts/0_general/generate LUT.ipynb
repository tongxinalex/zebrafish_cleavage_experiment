   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "lut_name = \"afmhot\"\n",
    "cmap = plt.get_cmap(lut_name)\n",
    "gradient = np.arange(0,256) / 255\n",
    "lut = (cmap(gradient)[:, :3]*255).astype('int')\n",
    "np.savetxt(lut_name + '.lut', lut, fmt = '%d')"
   ]
